{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-deck/session.stop/v1/in",
  "title": "session.stop input",
  "type": "object",
  "properties": {
    "force": {
      "description": "Skip agent exit and kill immediately",
      "type": "boolean"
    },
    "profile": {
      "description": "Profile whose store holds the session",
      "type": "string"
    },
    "session": {
      "description": "Session id, id prefix, title or path",
      "type": "string"
    },
    "timeout_seconds": {
      "description": "Graceful exit timeout in seconds (default 20)",
      "type": "integer"
    }
  },
  "required": [
    "profile",
    "session"
  ],
  "additionalProperties": false
}
